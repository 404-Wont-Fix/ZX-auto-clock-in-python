# 应用配置
APP_NAME=ZK Admin
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-secret-key-in-production

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin


# 管理员路径配置（安全功能：隐藏真实管理路径）
# 建议修改为自定义路径，如: my-secret-admin, backend-panel, manager123
# 访问该路径才能看到登录页面，其他路径显示 nginx 欢迎页
ADMIN_PATH=admin


# 数据库
DATABASE_URL=sqlite:///database/zk_admin.db

# clockin-worker 配置
CLOCKIN_API_URL=https://zk-clockin-executor.xxx.workers.dev
CLOCKIN_API_TOKEN=

# 打卡延迟配置
API_REQUEST_DELAY=500
CLOCKIN_TYPE_DELAY=2

# 打卡重试配置
CLOCKIN_RETRY_COUNT=3
CLOCKIN_RETRY_DELAY=3
CLOCKIN_TIMEOUT=60
CLOCKIN_RATE_LIMIT_DELAY=10

# 批处理配置
BATCH_SIZE=3
BATCH_DELAY=2000
PARALLEL_TASKS=4

# 定时任务 (Cron 表达式: 秒 分 时 日 月 周)
# 默认使用北京时间 0:10 执行
SCHEDULE_CRON=0 10 0 * * *
SCHEDULE_TIMEZONE=Asia/Shanghai

# 数据保留天数
RETENTION_DAYS=7

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs

# CORS 配置
CORS_ORIGINS=["http://localhost:8000", "http://localhost:3000"]
