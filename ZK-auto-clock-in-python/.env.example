# 应用配置
APP_NAME=ZK Admin
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-secret-key-in-production

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# 数据库
DATABASE_URL=sqlite:///database/zk_admin.db

# clockin-worker 配置
CLOCKIN_API_URL=https://zk-clockin-executor.xxx.workers.dev
CLOCKIN_API_TOKEN=local-dev-token-Tian

# 批处理配置
BATCH_SIZE=3
BATCH_DELAY=2000
PARALLEL_TASKS=4

# 定时任务 (Cron 表达式: 秒 分 时 日 月 周)
# 北京时间 0:10 = UTC 16:10
SCHEDULE_CRON=0 10 16 * * *

# 数据保留天数
RETENTION_DAYS=7

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs

# CORS 配置
CORS_ORIGINS=["http://localhost:8000", "http://localhost:3000"]
